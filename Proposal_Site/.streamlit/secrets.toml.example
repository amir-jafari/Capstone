# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. NEVER commit secrets.toml.

[admin]
password = "change-me"
name = "Amir Jafari"

# Optional locally. When set, the site reads/writes the GitHub repo directly
# (required on Streamlit Cloud so submissions are committed to the repo).
[github]
token = "github_pat_..."        # fine-grained PAT: repo amir-jafari/Capstone, Contents: Read and write
repo = "amir-jafari/Capstone"
branch = "main"

[site]
advisor_name = "Amir Jafari"
advisor_email = "ajafari@gwu.edu"
